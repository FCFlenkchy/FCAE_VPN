<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".FCAEApplication"
        android:allowBackup="false"
        android:label="FCAE VPN"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FCAEVPN"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasCode="true">

        <activity
            android:name=".VpnTileActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FCAEVpnService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <service
            android:name=".ProxyNotification"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
        </service>

        <!-- Separate process: AAR Go runtime must not share an address space
             with tun2socks. The service is bound to the app-owned foreground
             service AND is itself a specialUse foreground service: task-removal
             cleanup (and OEM task managers) kill the app's non-foreground
             processes on swipe, which tore the tunnel down mid-session. It
             posts the OWNER's notification id and content (psiOwner extra,
             via the owners' buildConnecting helpers), so the app still shows
             exactly one notification. -->
        <service
            android:name=".PsiphonTunnelService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse"
            android:process=":psiphon">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="psiphon-tunnel" />
        </service>

        <service
            android:name=".VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_fcae_vpn"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".VpnWidgetProvider"
            android:exported="true">
            <!--
                Only what the system must be able to deliver to a process that
                is NOT running: the widget lifecycle, and the button taps
                (PendingIntents, which the launcher sends without the app).
                The app's own state actions used to be listed here too, and a
                manifest receiver is delivered by STARTING its process — so
                every state broadcast, including the ones a teardown sends on
                its way out and the AAR's 1 Hz telemetry, was bringing the app
                back after it had been killed. The widget renders from
                SessionState directly (same process) instead.
            -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fc.fcaevpn.WIDGET_TOGGLE" />
                <action android:name="com.fc.fcaevpn.WIDGET_PAUSE_RESUME" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vpn_info" />
        </receiver>
    </application>
</manifest>
