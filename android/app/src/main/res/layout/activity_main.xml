<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="#FF141420">

    <!-- Scrollable controls area — fills all space above the fixed log section -->
    <ScrollView
        android:id="@+id/outerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FCAE VPN"
                android:textColor="#FFE8ECF4"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DISCONNECTED"
                android:textColor="#FF8A93A6"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/statsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="\u2193 0 B/s  |  \u2191 0 B/s  |  RTT \u2014"
                android:textColor="#FFB0B8C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/peerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Peer: \u2014"
                android:textColor="#FF7A8499"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="CONNECT"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdates"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Check for Updates"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minHeight="44dp"
                android:textColor="#FF60A5FA" />

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="#FF9AA3B5"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutoUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Auto-check for updates"
                android:textColor="#FFE0E4EE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Protocol"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerProtocol"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mode"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Scan"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerScan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="IP Version"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerIpVersion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Obfuscation"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerNoize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="ECH (Encrypted Client Hello)"
                android:textColor="#FFE0E4EE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchQuick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick reconnect"
                android:textColor="#FFE0E4EE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LAN sharing"
                android:textColor="#FFE0E4EE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MASQUE SNI (optional)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editSni"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="default consumer-masque..."
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Force Peer (optional)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editForcePeer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="ip:port"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLogging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="Enable logging"
                android:textColor="#FFE0E4EE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="SOCKS5 proxy (:1819)"
                android:textColor="#FFE0E4EE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHttp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="HTTP proxy (:1820)"
                android:textColor="#FFE0E4EE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="SOCKS5 port"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editSocksPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:inputType="number"
                android:padding="12dp"
                android:text="1819"
                android:textColor="#FFE8ECF4"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="HTTP proxy port"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editHttpPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:inputType="number"
                android:padding="12dp"
                android:text="1820"
                android:textColor="#FFE8ECF4"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Zero Trust (Teams)"
                android:textColor="#FF60A5FA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Team name"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editTeam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="my-team"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Access token (JWT)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editAccessToken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="token=..."
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Email (for OTP login)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editAccessEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="user@example.com"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Routing file (optional)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editRoutesFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:hint="/path/to/routes.txt"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Inline routing rules"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editRoutesInline"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:gravity="top|start"
                android:hint="[direct]ip:190.9.2.4,domain.com [block]gazo.com,10.0.0.0/8"
                android:inputType="textMultiLine|textVisiblePassword"
                android:padding="12dp"
                android:textColor="#FFE8ECF4"
                android:textColorHint="#FF5A6478"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sysprofile (performance)"
                android:textColor="#FF9AA3B5"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerSysprofile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#FF1E1E2C"
                android:popupBackground="#FF1E1E2C" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed log section at bottom — NO nested ScrollView, no scroll fighting -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="Logs"
        android:textColor="#FF9AA3B5"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#FF0C0C14"
        android:padding="10dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFA0A8B8"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLogs"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy logs"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLogs"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear logs"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
