<resources>
    <!-- The UI is a fixed dark design (hardcoded #141420 window and field
         backgrounds), so the theme must never resolve to light-mode values.
         The parent is a *DayNight* theme: before Android 13 it usually
         resolved to the night variant, but on recent Android versions
         (14/15) the device system setting is commonly "light", which made
         every widget that inherits the theme's text color (Spinner items,
         dialog titles, ...) render near-black on the dark background.
         Forcing MODE_NIGHT_YES in MainActivity handles the DayNight
         overlay; the explicit colors below are the safety net that keeps
         text light even on OEM ROMs that substitute their own theme
         values. -->
    <style name="Theme.FCAEVPN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF1A3A5C</item>
        <item name="colorPrimaryVariant">#FF0D2137</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="android:windowBackground">#FF141420</item>
        <!-- Primary/secondary text light on dark (matches the palette used
             in activity_main.xml: #E8ECF4 headings, #B0B8C8 secondary).
             Covers Spinner closed state, dialog titles, menu items, etc. -->
        <item name="android:textColorPrimary">#FFE8ECF4</item>
        <item name="android:textColorSecondary">#FFB0B8C8</item>
        <!-- EditText text/placeholder (attributes exist since API 14/21;
             minSdk is 26). -->
        <item name="android:editTextColor">#FFE8ECF4</item>
        <item name="android:textColorHint">#FF6B7280</item>
        <!-- Active controls (switch thumb/track, checkboxes): app accent
             blue instead of the theme default. -->
        <item name="android:colorControlActivated">#FF60A5FA</item>
        <!-- Links inside dialog message text (LinkMovementMethod). -->
        <item name="android:textColorLink">#FF60A5FA</item>
        <!-- System bars stay dark with light icons (API 23+, minSdk 26). -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Round icon button shared by About, sponsor refresh and sponsor audio;
         mirrors the desktop round_icon_button (20px circle, #334155 fill). -->
    <style name="Widget.FCAEVPN.IconButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#FF334155</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconTint">@null</item>
    </style>
</resources>
