<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed 3x2 widget: `resizeMode="none"` is what locks it (no drag handles, no
  launcher-driven resize), and the max values repeat the min ones for launchers
  that only honour the bounds. targetCell* is what modern launchers place it at;
  minWidth/minHeight carry the same intent on older ones ((70 x cells) - 30).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_vpn"
    android:maxResizeHeight="110dp"
    android:maxResizeWidth="180dp"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:resizeMode="none"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
